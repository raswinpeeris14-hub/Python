start_num=int(input("Enter The Start Value"))
end_value=int(input("Enter The End Value"))

for i in range(start_num,end_value+1):
    is_prime=True
    for j in range(start_num,i):
        if i % j == 0:
            is_prime=False
            break
    if is_prime == True:
        print(f"{i}",end="")
        print("")
